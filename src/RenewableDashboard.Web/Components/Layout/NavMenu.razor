@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager Navigation

<nav class="nav-links">
    @foreach (var link in _links)
    {
        <NavLink href="@link.Path" class="nav-link" ActiveClass="active">
            @link.Name
        </NavLink>
    }
</nav>

@code {
    private readonly (string Name, string Path)[] _links =
    [
        ("Home", "/"),
        ("Market", "/market"),
        ("Calculator", "/calculator"),
        ("Map", "/map"),
        ("AI Assistant", "/assistant")
    ];
}
