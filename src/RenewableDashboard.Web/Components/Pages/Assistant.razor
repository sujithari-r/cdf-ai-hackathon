@page "/assistant"
@using System.Net.Http.Json
@using RenewableDashboard.Core.DTOs
@using RenewableDashboard.Web.Services
@inject HttpClient Http
@inject LocationStateService LocationState
@inject CalculatorStateService CalculatorState
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>AI Assistant - Renewable Dashboard</PageTitle>

<div class="dashboard-page">
    <div class="dashboard-container">
        <section class="hero-section cyan">
            <div class="hero-grid cols-2">
                <div>
                    <div class="badge cyan">AI Research Assistant</div>
                    <h1 class="hero-title" style="font-size: clamp(2rem, 4vw, 3rem);">Speak with your renewable energy AI analyst</h1>
                    <p class="hero-text">
                        Ask about renewable energy markets, project economics,
                        location-based pricing, and investment tradeoffs using the live
                        dashboard context.
                    </p>
                    <div class="pill-row">
                        <span class="pill">Market-aware</span>
                        <span class="pill">Calculator-connected</span>
                        <span class="pill">Location-informed</span>
                    </div>
                </div>

                <div class="glass-panel">
                    <p class="panel-label">Live Context</p>
                    <div class="stat-grid cols-2">
                        <div class="stat-card span-2">
                            <p class="stat-label">Selected Location</p>
                            <p class="stat-value">@ContextSummary.Location</p>
                        </div>
                        <div class="stat-card">
                            <p class="stat-label">Electricity Rate</p>
                            <p class="stat-value emerald">@ContextSummary.Rate</p>
                        </div>
                        <div class="stat-card">
                            <p class="stat-label">Solar Score</p>
                            <p class="stat-value blue">@ContextSummary.SolarScore</p>
                        </div>
                        <div class="stat-card">
                            <p class="stat-label">Scenario</p>
                            <p class="stat-value" style="font-size: 1.25rem; text-transform: capitalize;">@ContextSummary.Scenario</p>
                        </div>
                        <div class="stat-card">
                            <p class="stat-label">NPV</p>
                            <p class="stat-value amber">@ContextSummary.Npv</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="content-grid cols-3">
            <div style="display: flex; flex-direction: column; gap: 1.5rem;">
                <div class="dark-card">
                    <p style="color: var(--emerald-200); font-size: 0.875rem;">AI Capabilities</p>
                    <h2 class="section-title" style="color: white; font-size: 1.5rem;">What this assistant can help with</h2>
                    <div style="margin-top: 1.25rem; display: flex; flex-direction: column; gap: 0.75rem;">
                        <div class="step-box"><p class="step-title">Market interpretation</p><p class="step-text">Understand price trends and growth signals.</p></div>
                        <div class="step-box"><p class="step-title">Project economics</p><p class="step-text">Explain NPV, NOI, revenue, and payback.</p></div>
                        <div class="step-box"><p class="step-title">Location tradeoffs</p><p class="step-text">Compare selected locations with financial assumptions.</p></div>
                    </div>
                </div>

                <div class="white-card">
                    <p class="section-subtitle">Quick Prompts</p>
                    <div style="margin-top: 1rem; display: flex; flex-direction: column; gap: 0.75rem;">
                        @foreach (var prompt in _quickPrompts)
                        {
                            <button class="location-btn" @onclick="() => SendMessage(prompt)" disabled="@_loading">
                                <p style="font-weight: 500; font-size: 0.875rem;">@prompt</p>
                            </button>
                        }
                    </div>
                </div>
            </div>

            <div class="white-card">
                <h2 class="section-title">AI analysis console</h2>
                <p class="section-subtitle">Your assistant uses the current dashboard context to answer with more relevant insights.</p>

                <div class="chat-window" style="margin-top: 1.25rem;" @ref="_chatContainer">
                    @foreach (var (message, index) in _messages.Select((m, i) => (m, i)))
                    {
                        <div class="chat-bubble @message.Role">
                            <p class="chat-role @message.Role">@(message.Role == "user" ? "You" : "AI Assistant")</p>
                            <p style="white-space: pre-wrap; line-height: 1.75;">@message.Content</p>
                        </div>

                        @if (message.Role == "assistant" && message.Suggestions?.Count > 0)
                        {
                            <div style="margin-bottom: 1rem;">
                                @foreach (var suggestion in message.Suggestions)
                                {
                                    <button class="suggestion-btn" @onclick="() => SendMessage(suggestion)" disabled="@_loading">
                                        @suggestion
                                    </button>
                                }
                            </div>
                        }
                    }

                    @if (_loading)
                    {
                        <div class="chat-bubble assistant">
                            <p class="chat-role assistant">AI Assistant</p>
                            <p class="kpi-subtitle">Analyzing dashboard context...</p>
                        </div>
                    }
                </div>

                <div style="margin-top: 1rem; border-radius: 1.5rem; border: 1px solid var(--slate-200); background: var(--slate-50); padding: 1rem;">
                    <textarea class="form-textarea" rows="2" @bind="_input" @bind:event="oninput"
                              placeholder="Ask about market trends, NPV, payback, location tradeoffs, or project returns..."
                              @onkeydown="HandleKeyDown"></textarea>
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.75rem;">
                        <p class="kpi-subtitle">Press Enter to send • Shift + Enter for a new line</p>
                        <button class="btn btn-dark" @onclick="() => SendMessage()" disabled="@(_loading || string.IsNullOrWhiteSpace(_input))">
                            @(_loading ? "Analyzing..." : "Send to AI")
                        </button>
                    </div>
                </div>
            </div>
        </section>
    </div>
</div>

@code {
    private sealed class ChatMessage
    {
        public string Role { get; init; } = "assistant";
        public string Content { get; init; } = string.Empty;
        public List<string>? Suggestions { get; init; }
    }

    private readonly List<ChatMessage> _messages =
    [
        new()
        {
            Role = "assistant",
            Content = "Hello. I'm your renewable energy AI analyst. I can help you evaluate market signals, project economics, selected locations, and investment tradeoffs using the current dashboard context.",
            Suggestions =
            [
                "Analyze the current project economics.",
                "Is the selected location a good investment opportunity?",
                "Explain the current NPV and payback in simple terms."
            ]
        }
    ];

    private readonly string[] _quickPrompts =
    [
        "Analyze the current project economics.",
        "Is the selected location a good investment opportunity?",
        "Explain the current NPV and payback in simple terms.",
        "Compare market signals with this calculator scenario."
    ];

    private string _input = string.Empty;
    private bool _loading;
    private ElementReference _chatContainer;

    private (string Location, string Rate, string SolarScore, string Scenario, string Npv) ContextSummary
    {
        get
        {
            var loc = LocationState.SelectedLocation;
            var calc = CalculatorState.Snapshot;
            return (
                loc?.Name ?? "No location selected",
                loc is not null ? $"${loc.ElectricityRate}/kWh" : "--",
                loc is not null ? $"{loc.SolarScore}/10" : "--",
                calc?.Scenario ?? "Not available",
                calc is not null ? $"${calc.Npv:N0}" : "--");
        }
    }

    protected override void OnInitialized()
    {
        LocationState.OnChange += StateHasChanged;
        CalculatorState.OnChange += StateHasChanged;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }

    private async Task SendMessage(string? messageText = null)
    {
        if (_loading) return;

        var finalMessage = (messageText ?? _input).Trim();
        if (string.IsNullOrWhiteSpace(finalMessage)) return;

        _messages.Add(new ChatMessage { Role = "user", Content = finalMessage });
        _input = string.Empty;
        _loading = true;

        try
        {
            var request = new AssistantRequestDto
            {
                Question = finalMessage,
                Context = new AssistantContextDto
                {
                    SelectedLocation = LocationState.SelectedLocation,
                    CalculatorSnapshot = CalculatorState.Snapshot
                }
            };

            var response = await Http.PostAsJsonAsync("/api/assistant", request);
            var data = await response.Content.ReadFromJsonAsync<AssistantResponseDto>();
            var answer = data?.Answer ?? "No response received.";

            _messages.Add(new ChatMessage
            {
                Role = "assistant",
                Content = answer,
                Suggestions = BuildFollowUpSuggestions(answer)
            });
        }
        catch
        {
            _messages.Add(new ChatMessage
            {
                Role = "assistant",
                Content = "Something went wrong while contacting the assistant.",
                Suggestions = ["Try that again.", "Summarize the current dashboard context."]
            });
        }
        finally
        {
            _loading = false;
        }
    }

    private static List<string> BuildFollowUpSuggestions(string answer)
    {
        var lower = answer.ToLowerInvariant();

        if (lower.Contains("npv") || lower.Contains("payback") || lower.Contains("revenue") || lower.Contains("noi"))
        {
            return
            [
                "Explain which input has the biggest impact on returns.",
                "How can I improve this project's NPV?",
                "Compare this with a more optimistic scenario."
            ];
        }

        if (lower.Contains("location") || lower.Contains("state") || lower.Contains("solar") || lower.Contains("electricity rate"))
        {
            return
            [
                "Compare this location with another state.",
                "How does the electricity rate affect project returns here?"
            ];
        }

        if (lower.Contains("market") || lower.Contains("trend") || lower.Contains("renewable share"))
        {
            return
            [
                "How should I use these market signals in the calculator?",
                "Summarize this market outlook in simple terms."
            ];
        }

        return
        [
            "Summarize that in simple terms.",
            "What should I look at next in the dashboard?",
            "Give me the key investment takeaway."
        ];
    }

    public void Dispose()
    {
        LocationState.OnChange -= StateHasChanged;
        CalculatorState.OnChange -= StateHasChanged;
    }
}
