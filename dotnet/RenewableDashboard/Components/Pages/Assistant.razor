@page "/assistant"
@inject AssistantService AssistantService
@inject DashboardState State
@implements IDisposable

<main class="min-h-screen bg-slate-950 px-6 py-10 md:px-10">
    <div class="mx-auto max-w-7xl space-y-8">
        <section class="relative overflow-hidden rounded-[32px] border border-white/10 bg-gradient-to-br from-slate-950 via-slate-900 to-cyan-950/50 p-8 shadow-2xl md:p-10">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(59,130,246,0.16),transparent_30%),radial-gradient(circle_at_bottom_right,rgba(16,185,129,0.14),transparent_30%)]"></div>

            <div class="relative grid gap-8 lg:grid-cols-[1.15fr_0.85fr]">
                <div>
                    <div class="inline-flex rounded-full border border-cyan-400/20 bg-cyan-400/10 px-3 py-1 text-sm font-medium text-cyan-300">AI Research Assistant</div>
                    <h1 class="mt-5 text-4xl font-bold tracking-tight text-white md:text-5xl">Speak with your renewable energy AI analyst</h1>
                    <p class="mt-4 max-w-3xl text-lg leading-8 text-slate-300">
                        Ask about renewable energy markets, project economics,
                        location-based pricing, and investment tradeoffs using the live dashboard context.
                    </p>
                    <div class="mt-8 flex flex-wrap gap-3">
                        <div class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-slate-200">Market-aware</div>
                        <div class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-slate-200">Calculator-connected</div>
                        <div class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-slate-200">Location-informed</div>
                        <div class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-slate-200">AI-generated insights</div>
                    </div>
                </div>

                <div class="rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm">
                    <p class="text-sm uppercase tracking-[0.2em] text-slate-400">Live Context</p>
                    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
                        <div class="rounded-2xl border border-white/10 bg-black/20 p-4 sm:col-span-2">
                            <p class="text-sm text-slate-400">Selected Location</p>
                            <p class="mt-2 text-2xl font-bold text-white">@Ctx.Location</p>
                        </div>
                        <div class="rounded-2xl border border-white/10 bg-black/20 p-4">
                            <p class="text-sm text-slate-400">Electricity Rate</p>
                            <p class="mt-2 text-2xl font-bold text-emerald-300">@Ctx.Rate</p>
                        </div>
                        <div class="rounded-2xl border border-white/10 bg-black/20 p-4">
                            <p class="text-sm text-slate-400">Solar Score</p>
                            <p class="mt-2 text-2xl font-bold text-blue-300">@Ctx.SolarScore</p>
                        </div>
                        <div class="rounded-2xl border border-white/10 bg-black/20 p-4">
                            <p class="text-sm text-slate-400">Scenario</p>
                            <p class="mt-2 text-xl font-bold text-white capitalize">@Ctx.Scenario</p>
                        </div>
                        <div class="rounded-2xl border border-white/10 bg-black/20 p-4">
                            <p class="text-sm text-slate-400">NPV</p>
                            <p class="mt-2 text-xl font-bold text-amber-300">@Ctx.Npv</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="grid grid-cols-1 gap-6 lg:grid-cols-[0.75fr_1.25fr]">
            <div class="space-y-6">
                <section class="rounded-3xl border border-emerald-400/20 bg-gradient-to-br from-slate-900 to-emerald-950 p-6 text-white shadow-xl">
                    <p class="text-sm text-emerald-200">AI Capabilities</p>
                    <h2 class="mt-2 text-2xl font-semibold">What this assistant can help with</h2>
                    <div class="mt-5 space-y-3">
                        <div class="rounded-2xl border border-white/10 bg-white/10 p-4">
                            <p class="font-medium">Market interpretation</p>
                            <p class="mt-1 text-sm text-slate-200">Understand price trends, renewable share, and growth signals.</p>
                        </div>
                        <div class="rounded-2xl border border-white/10 bg-white/10 p-4">
                            <p class="font-medium">Project economics</p>
                            <p class="mt-1 text-sm text-slate-200">Explain NPV, NOI, revenue, and payback in plain English.</p>
                        </div>
                        <div class="rounded-2xl border border-white/10 bg-white/10 p-4">
                            <p class="font-medium">Location tradeoffs</p>
                            <p class="mt-1 text-sm text-slate-200">Compare selected locations with financial assumptions.</p>
                        </div>
                    </div>
                </section>

                <section class="rounded-3xl border border-white/10 bg-white p-6 shadow-xl">
                    <p class="text-sm text-slate-500">Quick Prompts</p>
                    <div class="mt-4 space-y-3">
                        @foreach (var prompt in _quickPrompts)
                        {
                            <button @onclick="() => SendMessage(prompt)" disabled="@_loading"
                                    class="w-full rounded-2xl border border-slate-200 bg-slate-50 p-4 text-left transition hover:bg-slate-100 disabled:opacity-50">
                                <p class="text-sm font-medium text-slate-800">@prompt</p>
                            </button>
                        }
                    </div>
                </section>

                <section class="rounded-3xl border border-white/10 bg-white p-6 shadow-xl">
                    <p class="text-sm text-slate-500">Current Financial Context</p>
                    <div class="mt-4 grid grid-cols-1 gap-4">
                        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                            <p class="text-sm text-slate-500">Annual Revenue</p>
                            <p class="mt-2 text-2xl font-bold text-slate-900">@Ctx.Revenue</p>
                        </div>
                        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                            <p class="text-sm text-slate-500">Net Operating Income</p>
                            <p class="mt-2 text-2xl font-bold text-slate-900">@Ctx.Noi</p>
                        </div>
                        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                            <p class="text-sm text-slate-500">Payback Period</p>
                            <p class="mt-2 text-2xl font-bold text-slate-900">@Ctx.Payback</p>
                        </div>
                    </div>
                </section>
            </div>

            <section class="rounded-[28px] border border-white/10 bg-white p-6 shadow-xl md:p-8">
                <div class="mb-6 flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                    <div>
                        <p class="text-sm text-slate-500">Conversation</p>
                        <h2 class="mt-2 text-3xl font-semibold text-slate-900">AI analysis console</h2>
                        <p class="mt-2 text-sm text-slate-500">Your assistant uses the current dashboard context to answer with more relevant insights.</p>
                    </div>
                    <div class="inline-flex rounded-full border border-cyan-200 bg-cyan-50 px-3 py-1 text-xs text-cyan-700">Live AI session</div>
                </div>

                <div class="mb-5 h-[560px] overflow-y-auto rounded-3xl border border-slate-200 bg-gradient-to-b from-slate-50 to-white p-4 md:p-5">
                    <div class="space-y-4">
                        @foreach (var message in _messages)
                        {
                            <div>
                                <div class="@($"flex {(message.Role == "user" ? "justify-end" : "justify-start")}")">
                                    <div class="@($"max-w-[85%] rounded-2xl p-4 shadow-sm {(message.Role == "user" ? "bg-slate-900 text-white" : "border border-slate-200 bg-white text-slate-800")}")">
                                        <p class="@($"mb-2 text-xs font-semibold uppercase tracking-[0.15em] {(message.Role == "user" ? "text-slate-300" : "text-cyan-700")}")">
                                            @(message.Role == "user" ? "You" : "AI Assistant")
                                        </p>
                                        <p class="whitespace-pre-wrap leading-7">@message.Content</p>
                                    </div>
                                </div>

                                @if (message.Role == "assistant" && message.Suggestions.Count > 0)
                                {
                                    <div class="mt-3 flex justify-start">
                                        <div class="max-w-[85%]">
                                            <div class="flex flex-wrap gap-2">
                                                @foreach (var suggestion in message.Suggestions)
                                                {
                                                    <button @onclick="() => SendMessage(suggestion)" disabled="@_loading"
                                                            class="rounded-full border border-cyan-200 bg-cyan-50 px-3 py-2 text-sm text-cyan-700 transition hover:bg-cyan-100 disabled:opacity-50">
                                                        @suggestion
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        @if (_loading)
                        {
                            <div class="flex justify-start">
                                <div class="max-w-[85%] rounded-2xl border border-slate-200 bg-white p-4 text-slate-800 shadow-sm">
                                    <p class="mb-2 text-xs font-semibold uppercase tracking-[0.15em] text-cyan-700">AI Assistant</p>
                                    <div class="flex items-center gap-2">
                                        <span class="h-2.5 w-2.5 animate-pulse rounded-full bg-cyan-500"></span>
                                        <span class="h-2.5 w-2.5 animate-pulse rounded-full bg-cyan-500"></span>
                                        <span class="h-2.5 w-2.5 animate-pulse rounded-full bg-cyan-500"></span>
                                        <p class="ml-2 text-sm text-slate-500">Analyzing dashboard context...</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="rounded-3xl border border-slate-200 bg-slate-50 p-4">
                    <div class="flex flex-col gap-3">
                        <textarea rows="2" @bind="_input" @bind:event="oninput"
                                  placeholder="Ask about market trends, NPV, payback, location tradeoffs, or project returns..."
                                  class="max-h-[180px] min-h-[56px] w-full resize-none rounded-2xl border border-slate-200 bg-white p-4 text-slate-900 outline-none transition focus:border-slate-400"></textarea>
                        <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                            <p class="text-xs text-slate-500">Responses use the live dashboard context.</p>
                            <button @onclick="() => SendMessage(null)" disabled="@(_loading || string.IsNullOrWhiteSpace(_input))"
                                    class="rounded-2xl bg-slate-900 px-6 py-3 font-medium text-white transition hover:bg-slate-800 disabled:cursor-not-allowed disabled:opacity-50">
                                @(_loading ? "Analyzing..." : "Send to AI")
                            </button>
                        </div>
                    </div>
                </div>
            </section>
        </section>
    </div>
</main>

@code {
    private class UiMessage
    {
        public string Role { get; set; } = "assistant";
        public string Content { get; set; } = string.Empty;
        public List<string> Suggestions { get; set; } = new();
    }

    private readonly List<UiMessage> _messages = new();
    private string _input = string.Empty;
    private bool _loading;

    private readonly string[] _quickPrompts =
    {
        "Analyze the current project economics.",
        "Is the selected location a good investment opportunity?",
        "Explain the current NPV and payback in simple terms.",
        "Compare market signals with this calculator scenario.",
    };

    private ContextSummary Ctx => BuildContext();

    protected override void OnInitialized()
    {
        State.OnChange += StateHasChanged;

        _messages.Add(new UiMessage
        {
            Role = "assistant",
            Content = "Hello. I'm your renewable energy AI analyst. I can help you evaluate market signals, project economics, selected locations, and investment tradeoffs using the current dashboard context.",
            Suggestions = new()
            {
                "Analyze the current project economics.",
                "Is the selected location a good investment opportunity?",
                "Explain the current NPV and payback in simple terms.",
            },
        });
    }

    private async Task SendMessage(string? messageText)
    {
        if (_loading) return;

        var finalMessage = (messageText ?? _input).Trim();
        if (string.IsNullOrEmpty(finalMessage)) return;

        _messages.Add(new UiMessage { Role = "user", Content = finalMessage });
        _input = string.Empty;
        _loading = true;
        StateHasChanged();

        try
        {
            var answer = await AssistantService.AskAsync(
                finalMessage, State.SelectedLocation, State.CalculatorSnapshot, State.SessionId);

            _messages.Add(new UiMessage
            {
                Role = "assistant",
                Content = answer,
                Suggestions = BuildFollowUpSuggestions(answer),
            });
        }
        catch
        {
            _messages.Add(new UiMessage
            {
                Role = "assistant",
                Content = "Something went wrong while contacting the assistant.",
                Suggestions = new() { "Try that again.", "Summarize the current dashboard context.", "Analyze the selected location instead." },
            });
        }
        finally
        {
            _loading = false;
        }
    }

    private static List<string> BuildFollowUpSuggestions(string answer)
    {
        var a = answer.ToLowerInvariant();

        if (a.Contains("npv") || a.Contains("payback") || a.Contains("revenue") || a.Contains("noi"))
        {
            return new() { "Explain which input has the biggest impact on returns.", "How can I improve this project's NPV?", "Compare this with a more optimistic scenario." };
        }

        if (a.Contains("location") || a.Contains("state") || a.Contains("solar") || a.Contains("electricity rate"))
        {
            return new() { "Compare this location with another state.", "Is this location better for revenue or long-term growth?", "How does the electricity rate affect project returns here?" };
        }

        if (a.Contains("market") || a.Contains("trend") || a.Contains("renewable share") || a.Contains("capacity growth"))
        {
            return new() { "How should I use these market signals in the calculator?", "What is the main investment risk from this market view?", "Summarize this market outlook in simple terms." };
        }

        return new() { "Summarize that in simple terms.", "What should I look at next in the dashboard?", "Give me the key investment takeaway." };
    }

    private record ContextSummary(string Location, string Rate, string SolarScore, string Scenario, string Npv, string Revenue, string Noi, string Payback);

    private ContextSummary BuildContext()
    {
        var loc = State.SelectedLocation;
        var snap = State.CalculatorSnapshot;

        return new ContextSummary(
            loc?.Name ?? "No location selected",
            loc is not null ? $"${loc.ElectricityRate}/kWh" : "--",
            loc is not null ? $"{loc.SolarScore}/10" : "--",
            snap?.Scenario.ToString() ?? "Not available",
            snap is not null ? $"${snap.Npv:N0}" : "--",
            snap is not null ? $"${snap.AnnualRevenue:N0}" : "--",
            snap is not null ? $"${snap.NetOperatingIncome:N0}" : "--",
            snap?.PaybackPeriod is not null ? $"{snap.PaybackPeriod.Value:F1} years" : "Not available");
    }

    public void Dispose() => State.OnChange -= StateHasChanged;
}
