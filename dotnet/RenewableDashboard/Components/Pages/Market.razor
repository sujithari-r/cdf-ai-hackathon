@page "/market"
@inject MarketService MarketService
@inject IJSRuntime JS

<main class="min-h-screen bg-slate-950 px-6 py-10 md:px-10">
    <div class="mx-auto max-w-7xl space-y-8">
        <section class="relative overflow-hidden rounded-[32px] border border-white/10 bg-gradient-to-br from-slate-950 via-slate-900 to-blue-950/50 p-8 shadow-2xl md:p-10">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(59,130,246,0.14),transparent_30%),radial-gradient(circle_at_bottom_right,rgba(16,185,129,0.10),transparent_30%)]"></div>

            <div class="relative grid gap-8 lg:grid-cols-[1.1fr_0.9fr]">
                <div>
                    <div class="inline-flex rounded-full border border-blue-400/20 bg-blue-400/10 px-3 py-1 text-sm font-medium text-blue-300">Market Analysis</div>
                    <h1 class="mt-4 text-4xl font-bold tracking-tight text-white md:text-5xl">Renewable market trends</h1>
                    <p class="mt-4 max-w-3xl text-lg leading-8 text-slate-300">
                        Explore electricity price movement, capacity growth, and
                        renewable penetration through a cleaner analytics-focused market view.
                    </p>

                    <div class="mt-8 grid gap-4 sm:grid-cols-3">
                        <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                            <p class="text-sm text-slate-400">Trend Range</p>
                            <p class="mt-2 text-2xl font-bold text-white">@(_range == "6M" ? "6M" : "ALL")</p>
                        </div>
                        <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                            <p class="text-sm text-slate-400">Latest Month</p>
                            <p class="mt-2 text-2xl font-bold text-white">@(_summary?.LatestMonth ?? "--")</p>
                        </div>
                        <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                            <p class="text-sm text-slate-400">Direction</p>
                            <p class="mt-2 text-2xl font-bold text-white">
                                @(_summary is null ? "--" : (_summary.IsPositive ? "Uptrend" : "Downtrend"))
                            </p>
                        </div>
                    </div>
                </div>

                <div class="rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm">
                    <div class="flex items-center justify-between">
                        <p class="text-sm uppercase tracking-[0.2em] text-slate-400">Market Snapshot</p>
                        <div class="inline-flex rounded-full border border-white/10 bg-black/20 p-1">
                            <button @onclick='() => SetRange("6M")'
                                    class="@($"rounded-full px-3 py-1 text-xs font-medium transition {(_range == "6M" ? "bg-white text-slate-900" : "text-slate-300")}")">6M</button>
                            <button @onclick='() => SetRange("ALL")'
                                    class="@($"rounded-full px-3 py-1 text-xs font-medium transition {(_range == "ALL" ? "bg-white text-slate-900" : "text-slate-300")}")">All</button>
                        </div>
                    </div>

                    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
                        <div class="rounded-2xl border border-white/10 bg-black/20 p-4">
                            <p class="text-sm text-slate-400">Current Price</p>
                            <p class="mt-2 text-2xl font-bold text-white">@(_data is not null ? $"${_data.ElectricityPrice:F3}/kWh" : "--")</p>
                        </div>
                        <div class="rounded-2xl border border-white/10 bg-black/20 p-4">
                            <p class="text-sm text-slate-400">Capacity Growth</p>
                            <p class="mt-2 text-2xl font-bold text-emerald-300">@(_data is not null ? $"{_data.CapacityGrowth:F1}%" : "--")</p>
                        </div>
                        <div class="rounded-2xl border border-white/10 bg-black/20 p-4">
                            <p class="text-sm text-slate-400">Renewable Share</p>
                            <p class="mt-2 text-2xl font-bold text-blue-300">@(_data is not null ? $"{_data.RenewableShare:F0}%" : "--")</p>
                        </div>
                        <div class="rounded-2xl border border-white/10 bg-black/20 p-4">
                            <p class="text-sm text-slate-400">Trend Change</p>
                            <p class="@($"mt-2 text-2xl font-bold {(_summary?.IsPositive == true ? "text-emerald-300" : "text-rose-300")}")">
                                @(_summary is not null ? $"{(_summary.IsPositive ? "+" : "")}{_summary.Percentage:F1}%" : "--")
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        @if (_data is null)
        {
            <section class="grid grid-cols-1 gap-6 md:grid-cols-3">
                @for (var i = 0; i < 3; i++)
                {
                    <div class="rounded-3xl border border-white/10 bg-slate-900 p-6 animate-pulse">
                        <div class="mb-4 h-4 w-28 rounded bg-slate-700"></div>
                        <div class="mb-3 h-8 w-24 rounded bg-slate-700"></div>
                        <div class="h-3 w-40 rounded bg-slate-800"></div>
                    </div>
                }
            </section>
        }
        else
        {
            <section class="grid grid-cols-1 gap-6 md:grid-cols-3">
                <div class="rounded-3xl border border-emerald-400/20 bg-gradient-to-br from-white to-emerald-50 p-6 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl">
                    <p class="text-sm text-slate-500">Electricity Price</p>
                    <p class="mt-3 text-4xl font-bold text-slate-900">$@($"{_data.ElectricityPrice:F3}")</p>
                    <p class="mt-1 text-sm text-slate-500">per kWh</p>
                    <div class="mt-5 h-1.5 rounded-full bg-emerald-100"><div class="h-1.5 w-[72%] rounded-full bg-emerald-500"></div></div>
                </div>
                <div class="rounded-3xl border border-blue-400/20 bg-gradient-to-br from-white to-blue-50 p-6 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl">
                    <p class="text-sm text-slate-500">Capacity Growth</p>
                    <p class="mt-3 text-4xl font-bold text-slate-900">@($"{_data.CapacityGrowth:F1}")%</p>
                    <p class="mt-1 text-sm text-slate-500">Growth indicator</p>
                    <div class="mt-5 h-1.5 rounded-full bg-blue-100"><div class="h-1.5 w-[58%] rounded-full bg-blue-500"></div></div>
                </div>
                <div class="rounded-3xl border border-violet-400/20 bg-gradient-to-br from-white to-violet-50 p-6 shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl">
                    <p class="text-sm text-slate-500">Renewable Share</p>
                    <p class="mt-3 text-4xl font-bold text-slate-900">@($"{_data.RenewableShare:F0}")%</p>
                    <p class="mt-1 text-sm text-slate-500">Renewable penetration</p>
                    <div class="mt-5 h-1.5 rounded-full bg-violet-100"><div class="h-1.5 w-[32%] rounded-full bg-violet-500"></div></div>
                </div>
            </section>

            @if (_summary is not null)
            {
                <section class="grid grid-cols-1 gap-6 lg:grid-cols-[1.15fr_0.85fr]">
                    <div class="rounded-[28px] border border-white/10 bg-white p-6 shadow-xl md:p-8">
                        <div class="mb-6 flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                            <div>
                                <h2 class="text-3xl font-semibold text-slate-900">Price Trend</h2>
                                <p class="mt-2 text-sm text-slate-500">National monthly electricity price trend</p>
                            </div>
                            <div class="inline-flex rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs text-slate-600">Source: EIA Open Data API</div>
                        </div>
                        <div class="rounded-3xl border border-slate-200 bg-gradient-to-b from-slate-50 to-white p-4">
                            <div class="h-96 min-w-0"><canvas id="market-trend-chart"></canvas></div>
                        </div>
                    </div>

                    <div class="space-y-6">
                        <div class="rounded-3xl border border-white/10 bg-white p-6 shadow-xl">
                            <h2 class="text-2xl font-semibold text-slate-900">Trend Summary</h2>
                            <div class="mt-5 grid grid-cols-2 gap-4">
                                <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                                    <p class="text-sm text-slate-500">Average</p>
                                    <p class="mt-2 text-2xl font-bold text-slate-900">$@($"{_summary.Average:F3}")</p>
                                </div>
                                <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                                    <p class="text-sm text-slate-500">Absolute Change</p>
                                    <p class="@($"mt-2 text-2xl font-bold {(_summary.IsPositive ? "text-emerald-600" : "text-rose-600")}")">
                                        @($"{(_summary.IsPositive ? "+" : "")}{_summary.Change:F3}")
                                    </p>
                                </div>
                                <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                                    <p class="text-sm text-slate-500">Minimum</p>
                                    <p class="mt-2 text-2xl font-bold text-slate-900">$@($"{_summary.Min:F3}")</p>
                                </div>
                                <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                                    <p class="text-sm text-slate-500">Maximum</p>
                                    <p class="mt-2 text-2xl font-bold text-slate-900">$@($"{_summary.Max:F3}")</p>
                                </div>
                            </div>
                        </div>

                        <div class="rounded-3xl border border-blue-400/20 bg-gradient-to-br from-slate-900 to-blue-950 p-6 shadow-xl text-white">
                            <p class="text-sm text-blue-200">Key Takeaways</p>
                            <h2 class="mt-2 text-2xl font-semibold">What stands out in this market view</h2>
                            <div class="mt-5 space-y-3">
                                <div class="rounded-2xl border border-white/10 bg-white/10 p-4">
                                    <p class="font-medium">Price direction</p>
                                    <p class="mt-1 text-sm text-slate-200">
                                        The selected range is showing a @(_summary.IsPositive ? "positive" : "negative") trend in electricity pricing.
                                    </p>
                                </div>
                                <div class="rounded-2xl border border-white/10 bg-white/10 p-4">
                                    <p class="font-medium">Revenue implication</p>
                                    <p class="mt-1 text-sm text-slate-200">Higher electricity prices can improve renewable project revenue assumptions.</p>
                                </div>
                                <div class="rounded-2xl border border-white/10 bg-white/10 p-4">
                                    <p class="font-medium">Planning context</p>
                                    <p class="mt-1 text-sm text-slate-200">Capacity growth and renewable share help frame broader market expansion and adoption.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            }

            <section class="grid grid-cols-1 gap-6 lg:grid-cols-2">
                <div class="rounded-3xl border border-white/10 bg-white p-6 shadow-xl">
                    <p class="text-sm text-slate-500">Investor Read</p>
                    <h2 class="mt-2 text-2xl font-semibold text-slate-900">What this means</h2>
                    <p class="mt-4 leading-8 text-slate-600">
                        Higher electricity prices can support stronger renewable
                        project revenue assumptions, while capacity growth and
                        renewable share provide useful direction on overall market momentum.
                    </p>
                    <div class="mt-6 space-y-3">
                        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                            <p class="font-medium text-slate-900">Revenue Signal</p>
                            <p class="mt-1 text-sm text-slate-500">Higher power prices can strengthen expected project value.</p>
                        </div>
                        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                            <p class="font-medium text-slate-900">Expansion Signal</p>
                            <p class="mt-1 text-sm text-slate-500">Capacity growth helps support broader sector momentum.</p>
                        </div>
                    </div>
                </div>

                <div class="rounded-3xl border border-emerald-400/20 bg-gradient-to-br from-slate-900 to-emerald-950 p-6 shadow-xl text-white">
                    <p class="text-sm text-emerald-200">How to use this tab</p>
                    <h2 class="mt-2 text-2xl font-semibold">Read the market before modeling</h2>
                    <p class="mt-4 leading-8 text-slate-200">
                        Use this tab to understand macro pricing direction first, then
                        move to the Map tab for state-level context and the Calculator
                        tab for project-specific returns.
                    </p>
                    <div class="mt-6 grid gap-3">
                        <div class="rounded-2xl border border-white/10 bg-white/10 p-4">
                            <p class="font-medium">1. Review price direction</p>
                            <p class="mt-1 text-sm text-slate-200">Check recent momentum using 6M or All.</p>
                        </div>
                        <div class="rounded-2xl border border-white/10 bg-white/10 p-4">
                            <p class="font-medium">2. Compare market strength</p>
                            <p class="mt-1 text-sm text-slate-200">Use growth and renewable share as context signals.</p>
                        </div>
                        <div class="rounded-2xl border border-white/10 bg-white/10 p-4">
                            <p class="font-medium">3. Move to project economics</p>
                            <p class="mt-1 text-sm text-slate-200">Use the Calculator once market conditions look favorable.</p>
                        </div>
                    </div>
                </div>
            </section>
        }
    </div>
</main>

@code {
    private MarketData? _data;
    private string _range = "ALL";
    private TrendSummary? _summary;

    private List<TrendPoint> FilteredTrend
    {
        get
        {
            if (_data?.Trend is null) return new();
            return _range == "6M" && _data.Trend.Count > 6
                ? _data.Trend.Skip(_data.Trend.Count - 6).ToList()
                : _data.Trend;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _data = await MarketService.GetMarketDataAsync();
        _summary = MarketService.BuildTrendSummary(FilteredTrend);
    }

    private void SetRange(string range)
    {
        _range = range;
        _summary = MarketService.BuildTrendSummary(FilteredTrend);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_data is not null && _summary is not null)
        {
            var trend = FilteredTrend;
            await JS.InvokeVoidAsync(
                "renewableCharts.renderLine",
                "market-trend-chart",
                trend.Select(p => p.Month).ToArray(),
                trend.Select(p => p.Price).ToArray());
        }
    }
}
