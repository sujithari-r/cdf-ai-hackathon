@page "/map"
@using Microsoft.AspNetCore.WebUtilities
@inject LocationService LocationService
@inject DashboardState State
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<main class="min-h-screen bg-slate-950 px-6 py-10 md:px-10">
    <div class="mx-auto max-w-7xl space-y-8">
        <section class="relative overflow-hidden rounded-[32px] border border-white/10 bg-gradient-to-br from-slate-950 via-slate-900 to-cyan-950/50 p-8 shadow-2xl md:p-10">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(59,130,246,0.16),transparent_30%),radial-gradient(circle_at_bottom_right,rgba(16,185,129,0.14),transparent_30%)]"></div>

            <div class="relative grid gap-8 lg:grid-cols-[1.15fr_0.85fr]">
                <div>
                    <div class="inline-flex rounded-full border border-cyan-400/20 bg-cyan-400/10 px-3 py-1 text-sm font-medium text-cyan-300">Geographic Insights</div>
                    <h1 class="mt-5 text-4xl font-bold tracking-tight text-white md:text-5xl">Renewable energy location intelligence</h1>
                    <p class="mt-4 max-w-3xl text-lg leading-8 text-slate-300">
                        Compare state-level renewable opportunity signals, select a
                        location, and push map-based electricity pricing into your project workflow.
                    </p>
                    <div class="mt-8 flex flex-wrap gap-3">
                        <div class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-slate-200">State-level pricing</div>
                        <div class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-slate-200">Solar score comparison</div>
                        <div class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-slate-200">Calculator-connected selection</div>
                    </div>
                </div>

                <div class="rounded-3xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm">
                    <p class="text-sm uppercase tracking-[0.2em] text-slate-400">Selected Location Snapshot</p>
                    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2">
                        <div class="rounded-2xl border border-white/10 bg-black/20 p-4 sm:col-span-2">
                            <p class="text-sm text-slate-400">Location</p>
                            <p class="mt-2 text-2xl font-bold text-white">@(State.SelectedLocation?.Name ?? "No location selected")</p>
                        </div>
                        <div class="rounded-2xl border border-white/10 bg-black/20 p-4">
                            <p class="text-sm text-slate-400">Electricity Rate</p>
                            <p class="mt-2 text-2xl font-bold text-emerald-300">@(State.SelectedLocation is not null ? $"${State.SelectedLocation.ElectricityRate}/kWh" : "--")</p>
                        </div>
                        <div class="rounded-2xl border border-white/10 bg-black/20 p-4">
                            <p class="text-sm text-slate-400">Solar Score</p>
                            <p class="mt-2 text-2xl font-bold text-blue-300">@(State.SelectedLocation is not null ? $"{State.SelectedLocation.SolarScore}/10" : "--")</p>
                        </div>
                    </div>
                    <div class="mt-5 rounded-2xl border border-cyan-400/15 bg-cyan-400/10 p-4">
                        <p class="text-sm text-cyan-200">Location Note</p>
                        <p class="mt-2 text-sm leading-7 text-slate-200">
                            @(State.SelectedLocation?.Note ?? "Choose a state from the map or the tracked locations panel.")
                        </p>
                    </div>
                </div>
            </div>
        </section>

        @if (_message == "select-location")
        {
            <section class="rounded-2xl border border-amber-400/20 bg-amber-400/10 p-4 shadow-sm">
                <h2 class="text-lg font-semibold text-amber-200">Please select a location</h2>
                <p class="mt-1 text-sm text-amber-100">
                    Choose a state on the map to use map-based electricity pricing in the calculator.
                </p>
            </section>
        }

        <section class="grid grid-cols-1 gap-6 xl:grid-cols-[1.15fr_0.85fr]">
            <div class="rounded-[28px] border border-white/10 bg-white p-4 shadow-xl md:p-5">
                <div class="mb-4 flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
                    <div>
                        <h2 class="text-2xl font-semibold text-slate-900">U.S. opportunity map</h2>
                        <p class="mt-1 text-sm text-slate-500">Click a marker to update the shared dashboard location context.</p>
                    </div>
                    <div class="inline-flex rounded-full border border-slate-200 bg-slate-50 px-3 py-1 text-xs text-slate-600">Live selection → Calculator context</div>
                </div>
                <div id="opportunity-map" class="h-[560px] w-full overflow-hidden rounded-3xl border border-slate-200"></div>
            </div>

            <div class="space-y-6">
                <section class="rounded-3xl border border-emerald-400/20 bg-gradient-to-br from-slate-900 to-emerald-950 p-6 text-white shadow-lg">
                    <p class="text-sm text-emerald-200">How to use this tab</p>
                    <h2 class="mt-2 text-2xl font-semibold">Select a state to drive pricing assumptions</h2>
                    <p class="mt-4 leading-7 text-slate-200">
                        Clicking a marker updates the shared dashboard context. That
                        selected electricity rate can then be used in the calculator or
                        compared against manual project assumptions.
                    </p>
                    <div class="mt-6 space-y-3">
                        <div class="rounded-2xl border border-white/10 bg-white/10 p-4">
                            <p class="font-medium">1. Review locations</p>
                            <p class="mt-1 text-sm text-slate-200">Explore opportunity signals across tracked states.</p>
                        </div>
                        <div class="rounded-2xl border border-white/10 bg-white/10 p-4">
                            <p class="font-medium">2. Select one state</p>
                            <p class="mt-1 text-sm text-slate-200">Choose a marker or use the tracked locations list.</p>
                        </div>
                        <div class="rounded-2xl border border-white/10 bg-white/10 p-4">
                            <p class="font-medium">3. Continue to modeling</p>
                            <p class="mt-1 text-sm text-slate-200">Use the selected rate inside the calculator workflow.</p>
                        </div>
                    </div>
                </section>

                <section class="rounded-3xl border border-white/10 bg-white p-6 shadow-lg">
                    <p class="text-sm text-slate-500">Tracked Locations</p>
                    <div class="mt-4 space-y-4">
                        @foreach (var location in _locations)
                        {
                            var isSelected = State.SelectedLocation?.Name == location.Name;
                            <button @onclick="() => SelectLocation(location)"
                                    class="@($"w-full rounded-2xl border p-4 text-left transition {(isSelected ? "border-slate-900 bg-slate-50 shadow-sm" : "border-slate-200 bg-white hover:bg-slate-50")}")">
                                <div class="flex items-start justify-between gap-3">
                                    <div>
                                        <h3 class="font-semibold text-slate-900">@location.Name</h3>
                                        <p class="mt-2 text-sm text-slate-500">Rate: $@(location.ElectricityRate)/kWh</p>
                                    </div>
                                    <span class="@($"rounded-full px-2.5 py-1 text-xs font-medium {(isSelected ? "bg-slate-900 text-white" : "bg-slate-100 text-slate-600")}")">@(location.SolarScore)/10</span>
                                </div>
                                <p class="mt-3 text-sm leading-6 text-slate-600">@location.Note</p>
                            </button>
                        }
                    </div>
                </section>
            </div>
        </section>
    </div>
</main>

@code {
    private List<Location> _locations = new();
    private string? _message;
    private DotNetObjectReference<Map>? _selfRef;

    protected override void OnInitialized()
    {
        State.OnChange += StateHasChanged;

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("message", out var value))
        {
            _message = value.ToString();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _locations = await LocationService.GetLocationsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _locations.Count > 0)
        {
            _selfRef = DotNetObjectReference.Create(this);
            var markers = _locations.Select(l => new
            {
                name = l.Name,
                latitude = l.Latitude,
                longitude = l.Longitude,
                electricityRate = l.ElectricityRate,
                solarScore = l.SolarScore,
                note = l.Note,
            }).ToArray();

            await JS.InvokeVoidAsync("renewableMap.init", "opportunity-map", markers, _selfRef);
        }
    }

    [JSInvokable]
    public void SelectLocationFromMap(string name)
    {
        var match = _locations.FirstOrDefault(l => l.Name == name);
        if (match is not null)
        {
            SelectLocation(match);
        }
    }

    private void SelectLocation(Location location)
    {
        State.SetSelectedLocation(new SelectedLocation
        {
            Name = location.Name,
            ElectricityRate = location.ElectricityRate,
            SolarScore = location.SolarScore,
            Note = location.Note,
        });
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
        _selfRef?.Dispose();
    }
}
