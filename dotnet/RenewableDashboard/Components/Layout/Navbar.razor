@inject NavigationManager Nav
@implements IDisposable

<header class="sticky top-0 z-50 border-b border-white/10 bg-slate-950/85 backdrop-blur-xl">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 md:px-10">
        <a href="/" class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-2xl border border-cyan-400/20 bg-cyan-400/10 text-sm font-bold text-cyan-300 shadow-lg shadow-cyan-950/30">
                RE
            </div>
            <div class="hidden sm:block">
                <p class="text-sm font-semibold tracking-wide text-white">
                    Renewable Dashboard
                </p>
                <p class="text-xs text-slate-400">
                    Market • Map • Calculator • AI
                </p>
            </div>
        </a>

        <nav class="flex items-center gap-2 rounded-2xl border border-white/10 bg-white/5 p-1.5">
            @foreach (var link in _links)
            {
                var isActive = IsActive(link.Path);
                <a href="@link.Path"
                   class="@($"rounded-xl px-4 py-2 text-sm font-medium transition-all duration-200 {(isActive ? "bg-gradient-to-r from-cyan-500 to-blue-500 text-white shadow-md" : "text-slate-300 hover:bg-white/10 hover:text-white")}")">
                    @link.Name
                </a>
            }
        </nav>
    </div>
</header>

@code {
    private record NavLink(string Name, string Path);

    private readonly NavLink[] _links =
    {
        new("Home", "/"),
        new("Market", "/market"),
        new("Calculator", "/calculator"),
        new("Map", "/map"),
        new("AI Assistant", "/assistant"),
    };

    protected override void OnInitialized()
    {
        Nav.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e) => StateHasChanged();

    private bool IsActive(string path)
    {
        var relative = "/" + Nav.ToBaseRelativePath(Nav.Uri);
        var current = relative.Split('?')[0].TrimEnd('/');
        if (string.IsNullOrEmpty(current))
        {
            current = "/";
        }

        var target = path.TrimEnd('/');
        if (string.IsNullOrEmpty(target))
        {
            target = "/";
        }

        return string.Equals(current, target, StringComparison.OrdinalIgnoreCase);
    }

    public void Dispose() => Nav.LocationChanged -= HandleLocationChanged;
}
